 application "petscop"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Cage_Enclosure_Master
		{
			displayname = "Cage/Enclosure Master"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Cage_ID
			(
    			type = autonumber
				displayname = "Cage ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cage_Type
			(
				type = picklist
				displayname = "Cage Type"
				maxchar = 100
				values = {"Kennel","Cage","Isolation","Quarantine","Holding Pen"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Block_Location
			(
    			type = text
				displayname = "Block/Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Capacity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Occupancy
			(
				type = number
				displayname = "Current Occupancy"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cage_Status
			(
				type = picklist
				displayname = "Cage Status"
				maxchar = 100
				values = {"Available","Full","Under Cleaning","Out of Service"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Foster_Master
		{
			displayname = "Foster Master"
			success message = "Foster Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Foster_ID
			(
    			type = autonumber
				displayname = "Foster ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Foster_Name
			(
    			type = name
				displayname = "Foster Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Species_Accepted
			(
				type = list	
				displayname = "Species Accepted"
				values = {"Dog","Cat","Bird","Cow","Monkey"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Max_Animals
			(
				type = number
				displayname = "Max Animals"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Experience_Level
			(
				type = picklist
				displayname = "Experience Level"
				maxchar = 100
				values = {"Beginner","Experienced","Medical-trained"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Availability
			(
				type = picklist
				maxchar = 100
				values = {"Available","Currently Fostering","On Break"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Foster_Placement
