		 functions
		 {
			 Deluge
			 {
				 void closeCageAssignments(int animalId)
                 {
                 	openList = Holding_Cage_Assignment[Animal == animalId && Moved_Out_Date == null];
                 	for each  a in openList
                 	{
                 		cageId = a.Cage;
                 		a.Moved_Out_Date=zoho.currentdate;
                 		thisapp.updateCageOccupancy(cageId);
                 	}
                 }
				 void refreshFosterAvailability(int fosterId)
                 {
                 	fosterRec = Foster_Master[ID == fosterId];
                 	activeCount = Foster_Placement[Foster == fosterId && Placement_Status == "Active"].count();
                 	if(fosterRec.Availability != "On Break")
                 	{
                 		if(activeCount >= fosterRec.Max_Animals)
                 		{
                 			fosterRec.Availability="Currently Fostering";
                 		}
                 		else
                 		{
                 			fosterRec.Availability="Available";
                 		}
                 	}
                 }
				 void updateCageOccupancy(int cageId)
                 {
                 	cageRec = Cage_Enclosure_Master[ID == cageId];
                 	occ = Holding_Cage_Assignment[Cage == cageId && Moved_Out_Date == null].count();
                 	cageRec.Current_Occupancy=occ;
                 	if(cageRec.Cage_Status != "Out of Service" && cageRec.Cage_Status != "Under Cleaning")
                 	{
                 		if(occ >= cageRec.Capacity)
                 		{
                 			cageRec.Cage_Status="Full";
                 		}
                 		else
                 		{
                 			cageRec.Cage_Status="Available";
                 		}
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			W1 as "W1"
			{
				type =  form
				form = Rescue_Report

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Current_Status = "In Holding";
						)
					}
					actions 
					{
						custom deluge script
						(
											input.Rescue_Date_Time = zoho.currenttime;
						)
					}
				}

			}
			W2 as "W2"
			{
				type =  form
				form = Rescue_Report

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Condition_on_Arrival == "Critical" || input.Condition_on_Arrival == "Serious")
										{
											input.Current_Status = "In Medical Care";
										}
										if(input.Condition_on_Arrival == "Critical")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :"vet@yourshelter.org"
												subject :"CRITICAL rescue admitted: " + input.Animal_ID
												message :"A critical-condition " + input.Species + " was rescued at " + input.Rescue_Location + ". Please attend immediately."
											]
										}
						)
					}
				}

			}
			W3 as "W3"
			{
				type =  form
				form = Rescue_Report

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Current_Status == "Released" || input.Current_Status == "Deceased")
										{
											thisapp.closeCageAssignments(input.ID);
											Current_Cage = null;
										}
						)
					}
				}

			}
			W4a as "W4a"
			{
				type =  form
				form = Injury_Record

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Injury_Date_Noted > zoho.currentdate)
										{
											alert "Injury date cannot be in the future.";
											cancel submit;
										}
						)
					}
				}

			}
			W4b as "W4b"
			{
				type =  form
				form = Injury_Record

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Severity == "Severe")
										{
											animalRec = Rescue_Report[ID == input.Animal];
											if(animalRec.Current_Status != "With Foster")
											{
												animalRec.Current_Status="In Medical Care";
											}
											sendmail
											[
												from :zoho.adminuserid
												to :"vet@yourshelter.org"
												subject :"Severe injury logged: " + animalRec.Animal_ID
												message :"Type: " + input.Injury_Type + ", Body part: " + input.Body_Part_Affected + ". Please review."
											]
										}
						)
					}
				}

			}
			W5a as "W5a"
			{
				type =  form
				form = Treatment_Plan_Log

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Next_Treatment_Due != null && input.Next_Treatment_Due < input.Treatment_Date)
										{
											alert "Next treatment due cannot be before the treatment date.";
											cancel submit;
										}
						)
					}
				}

			}
			W5b as "W5b"
			{
				type =  form
				form = Treatment_Plan_Log

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											animalRec = Rescue_Report[ID == input.Animal];
										// Escalate if the animal is getting worse
										if(input.Progress == "Declining")
										{
											if(animalRec.Current_Status != "With Foster")
											{
												animalRec.Current_Status="In Medical Care";
											}
											sendmail
											[
												from :zoho.adminuserid
												to :"vet@yourshelter.org"
												subject :"Animal declining: " + animalRec.Animal_ID
												message :"Latest treatment log marks progress as Declining. Please review the treatment plan."
											]
										}
						)
					}
				}

			}
			W6 as "W6"
			{
				type =  form
				form = Holding_Cage_Assignment

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											cageRec = Cage_Enclosure_Master[ID == input.Cage];
										if(cageRec.Cage_Status == "Out of Service" || cageRec.Cage_Status == "Under Cleaning")
										{
											alert "This cage is " + cageRec.Cage_Status + ". Choose another cage.";
											cancel submit;
										}
										if(cageRec.Current_Occupancy >= cageRec.Capacity)
										{
											alert "Cage " + cageRec.Cage_ID + " is full. Choose another cage.";
											cancel submit;
										}
						)
					}
				}

			}
			W7 as "W7"
			{
				type =  form
				form = Holding_Cage_Assignment

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Close any other open assignment for this animal
										otherOpen = Holding_Cage_Assignment[Animal == input.Animal && Moved_Out_Date == null && ID != input.ID];
										for each  a in otherOpen
										{
											oldCage = a.Cage;
											a.Moved_Out_Date=zoho.currentdate;
											thisapp.updateCageOccupancy(oldCage);
										}
										// Recount the cage for this assignment
										thisapp.updateCageOccupancy(input.Cage);
										// Keep the animal record in sync
										animalRec = Rescue_Report[ID == input.Animal];
										if(input.Moved_Out_Date == null)
										{
											if(animalRec.Current_Status == "With Foster" || animalRec.Current_Status == "Ready for Release")
											{
												animalRec.Current_Status="In Holding";
											}
										}
						)
					}
				}

			}
			W8 as "W8"
			{
				type =  form
				form = Foster_Placement

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											fosterRec = Foster_Master[ID == input.Foster];
										animalRec = Rescue_Report[ID == input.Animal];
										if(fosterRec.Availability == "On Break")
										{
											alert "This foster carer is currently on break.";
											cancel submit;
										}
										activeCount = Foster_Placement[Foster == input.Foster && Placement_Status == "Active"].count();
										if(activeCount >= fosterRec.Max_Animals)
										{
											alert "This foster is already at capacity (" + fosterRec.Max_Animals + " animals).";
											cancel submit;
										}
										if(!fosterRec.Species_Accepted.contains(animalRec.Species))
										{
											alert "This foster does not accept " + animalRec.Species + ".";
											cancel submit;
										}
										if(input.Expected_End_Date != null && input.Expected_End_Date < input.Placement_Start_Date)
										{
											alert "Expected end date cannot be before the start date.";
											cancel submit;
										}
						)
					}
				}

			}
			W9 as "W9"
			{
				type =  form
				form = Foster_Placement

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Animal moves out of the shelter
										animalRec = Rescue_Report[ID == input.Animal];
										animalRec.Current_Status="With Foster";
										thisapp.closeCageAssignments(input.Animal);
										// Update the foster's availability
										thisapp.refreshFosterAvailability(input.Foster);
										// Store the foster's email for record-level permissions
										fosterRec = Foster_Master[ID == input.Foster];
										Foster_Email = fosterRec.Email;
						)
					}
				}

			}
			W10 as "W10"
			{
				type =  form
				form = Foster_Placement

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											animalRec = Rescue_Report[ID == input.Animal];
										if(input.Placement_Status == "Completed")
										{
											animalRec.Current_Status="Ready for Release";
										}
										else if(input.Placement_Status == "Returned Early")
										{
											// Animal needs a cage again; staff assign one via Holding Assignment
											animalRec.Current_Status="In Holding";
										}
										thisapp.refreshFosterAvailability(input.Foster);
										if(input.Animal_Condition_at_Check_in == "Concern")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :"vet@yourshelter.org"
												subject :"Foster check-in concern: " + animalRec.Animal_ID
												message :"The foster reported a concern at check-in. Please follow up."
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			Treatment_Reminders as "Treatment Reminders"
			{
				type =  schedule
				start = "2026-10-30 08:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						dueList = Treatment_Plan_Log[Next_Treatment_Due != null && Next_Treatment_Due <= zoho.currentdate.addDay(1)];
										msg = "";
										for each  t in dueList
										{
											msg = msg + t.Animal.Animal_Name + " (" + t.Animal.Animal_ID + "): " + t.Treatment_Type + " due " + t.Next_Treatment_Due + "<br>";
										}
										if(dueList.count() > 0)
										{
											sendmail
											[
												from :zoho.adminuserid
												to :"vet@yourshelter.org"
												subject :"Treatments due: " + dueList.count() + " animal(s)"
												message :msg
											]
										}
					)
					}
				}
			}
			Capacity_Alert as "Capacity Alert"
			{
				type =  schedule
				start = "2026-10-30 09:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						activeCages = Cage_Enclosure_Master[Cage_Status != "Out of Service"];
										totalCap = ifnull(activeCages.sum(Capacity),0);
										totalOcc = ifnull(activeCages.sum(Current_Occupancy),0);
										if(totalCap > 0)
										{
											pct = (totalOcc * 100) / totalCap;
											if(pct >= 90)
											{
												sendmail
												[
													from :zoho.adminuserid
													to :"admin@yourshelter.org"
													subject :"Shelter near capacity: " + pct.round(0) + "% full"
													message :totalOcc + " of " + totalCap + " spaces are occupied. Consider fostering or transfers."
												]
											}
										}
					)
					}
				}
			}
		}




