	reports
	{
		default list Cage_Enclosure_Master_Report
		{
			displayName = "Cage/Enclosure Master Report"
			show all rows from Cage_Enclosure_Master    
			(
				Cage_ID as "Cage ID"
				Cage_Type as "Cage Type"
				Block_Location as "Block/Location"
				Capacity
				Current_Occupancy as "Current Occupancy"
				Cage_Status as "Cage Status"
			)
		}
		default list All_Rescue_Reports
		{
			displayName = "All Rescue Reports"
			show all rows from Rescue_Report    
			(
				Animal_ID as "Animal ID"
				Animal_Name as "Animal Name"
				Species
				Breed_Description as "Breed/Description"
				Approx_Age as "Approx. Age"
				Sex
				Photo
				Rescue_Date_Time as "Rescue Date & Time"
				Rescue_Location as "Rescue Location"
				Reported_By as "Reported By"
				Reporter_Contact as "Reporter Contact"
				(
					displayformat = plainnumber 
				)
				Rescued_By as "Rescued By"
				Rescue_Type as "Rescue Type"
				Condition_on_Arrival as "Condition on Arrival"
				Microchipped
				Current_Status as "Current Status"
				Cage_Enclosure_Master as "Cage/Enclosure Master"
			)
		}
		default list All_Injury_Records
		{
			displayName = "All Injury Records"
			show all rows from Injury_Record    
			(
				Animal
				Injury_Date_Noted as "Injury Date Noted"
				Injury_Type as "Injury Type"
				Body_Part_Affected as "Body Part Affected"
				Severity
				Description
				Injury_Photo as "Injury Photo"
				Assessed_by as "Assessed by"
				Recovery_Status as "Recovery Status"
			)
		}
		default list Treatment_Plan_Log_Report
		{
			displayName = "Treatment Plan/Log Report"
			show all rows from Treatment_Plan_Log    
			(
				Animal
				Injury_Record as "Injury Record"
				Treatment_Date as "Treatment Date"
				Treatment_Type as "Treatment Type"
				Medication_Procedure as "Medication/Procedure"
				Dosage
				Administered_by as "Administered by"
				Vet_Notes as "Vet Notes"
				Weight
				Next_Treatment_Due as "Next Treatment Due"
				Progress
			)
		}
		default list All_Foster_Masters
		{
			displayName = "All Foster Masters"
			show all rows from Foster_Master    
			(
				Foster_ID as "Foster ID"
				Foster_Name  as "Foster Name"
				Email
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Species_Accepted as "Species Accepted"
				Max_Animals as "Max Animals"
				Experience_Level as "Experience Level"
				Availability
			)
		}
		default list All_Foster_Placements
		{
			displayName = "All Foster Placements"
			show all rows from Foster_Placement    
			(
				Animal
				Foster
				Placement_Start_Date as "Placement Start Date"
				Expected_End_Date as "Expected End Date"
				Reason_for_Fostering as "Reason for Fostering"
				Care_Instructions as "Care Instructions"
				Check_in_Date as "Check-in Date"
				Animal_Condition_at_Check_in as "Animal Condition at Check-in"
				Placement_Status as "Placement Status"
			)
		}
		default list Holding_Cage_Assignment_Report
		{
			displayName = "Holding & Cage Assignment Report"
			show all rows from Holding_Cage_Assignment    
			(
				Animal
				Cage
				Assigned_Date as "Assigned Date"
				Holding_Reason as "Holding Reason"
				Expected_Move_Date as "Expected Move Date"
				Moved_Out_Date as "Moved Out Date"
			)
		}
		list Foster_Placement_Report
		{
			displayName = "Foster Placements List"
			show all rows from Foster_Placement    
			(
				Placement_Status as "Placement Status"
				Foster
				Animal
				Placement_Start_Date as "Placement Start Date"
				Expected_End_Date as "Expected End Date"
				Reason_for_Fostering as "Reason for Fostering"
				Care_Instructions as "Care Instructions"
				Animal_Condition_at_Check_in as "Animal Condition at Check-in"
				Check_in_Date as "Check-in Date"
			)
		}
		kanban Holding_Analysis
		{
			displayName = "Holding Analysis"
			show all rows from Holding_Cage_Assignment    
			(
				Animal
				Cage
				Assigned_Date as "Assigned Date"
				Holding_Reason as "Holding Reason"
				Expected_Move_Date as "Expected Move Date"
				Moved_Out_Date as "Moved Out Date"
			)
			options
			(
	 			display field = Cage
				sort order  = ascending
	 		)
		}
	}
	pages
	{
		page Foster_Placement_Dashboard
		{
			displayname = "Foster Placement Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='welcome_panel.welcome-links.elevated.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '0px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '3px'\n\tbgColor = '#D9D9D9'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'top'\n    \tcornerRadius = '9px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#F0F0F0'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'top'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '12px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'WELCOME'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#1C1C1C'\n\tsize = '28px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Foster Placement Dashboard'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Track and manage foster placements for animals'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\tpaddingLeft = '24px'\n\tpaddingRight = '24px'\n\tpaddingBottom = '24px'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '14px'\n\tbgColor = '#F7F7F7'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Foster_Placement_Report'\n\t\ttarget = 'same-window'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<image  \n\t\n\tcolor = 'theme'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\twidth = '20px'\n\theight = '20px'\n\ttype = 'icon'\n\tvalue = 'ui-2-fat-add'\n\tsize = '12px'\n\tcornerRadius = '0px'\n\ticonType = 'solid'\n/>\n</pc><pc \n\t\tpaddingLeft = '10px'\n\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#1C1C1C'\n\tsize = '13px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'View All Placements'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='2px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '11px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'See all foster placement records'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='active_placements_st